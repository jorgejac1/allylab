    "react-dom": "19.2.0",
    "resend": "^6.12.0",
    "stripe": "^22.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
